DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin used for the Google redirect URI and canonical URLs
AUTH_URL="http://localhost:3000"

# Optional. Hostname[:port] for supplier mini-sites (abc-engineering.localhost:3000).
# Defaults to AUTH_URL. Do not use *.vercel.app — that public suffix cannot host tenant cookies.
# APP_HOST="localhost:3000"

# Optional. Cookie Domain for session sharing on supplier subdomains (e.g. .procurex.com).
# Localhost sets .localhost automatically. Never set this to .vercel.app.
# COOKIE_DOMAIN=".procurex.com"

# On a real custom domain, set this so in-app "view profile" links use slug.yourdomain.com
# SUPPLIER_SUBDOMAINS="1"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Redirect URI must be exactly: {AUTH_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. First-party AnalyticsEvent rows in Postgres are the source of truth.
# Umami mirrors pageviews + custom events when a website id is set.
# Cloud: create a site at https://cloud.umami.is then paste the Website ID.
# Self-hosted: point the script URL at your tracker (collect URL is inferred as /api/send).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"
# UMAMI_COLLECT_URL=""
